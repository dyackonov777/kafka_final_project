# Скопируйте в .env (start.sh делает это автоматически) и поменяйте пароли.
# .env не попадает в Git. Пароли: только латинские буквы и цифры, минимум 8 символов.

# Адрес, на котором публикуются порты сервисов. 127.0.0.1 — доступ только с этой машины.
BIND_ADDRESS=127.0.0.1

# Пароль keystore/truststore (TLS). После смены: bash scripts/generate-certs.sh --force
KEYSTORE_PASSWORD=ChangeMeKafka2026

# Elasticsearch: администратор, пользователь Kafka Connect (запись), пользователь CLIENT API (чтение)
ELASTIC_PASSWORD=ChangeMeElastic2026
ES_CONNECT_PASSWORD=ChangeMeConnect2026
ES_CLIENT_PASSWORD=ChangeMeClient2026

# Kafka UI (форма входа)
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=ChangeMeKafkaUi2026

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMeGrafana2026

# Уведомления Alertmanager в Telegram (необязательно). Если пусто — только webhook.
# Токен выдаёт @BotFather, chat_id можно узнать через https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
